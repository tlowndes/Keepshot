# Copy to .env and adjust. .env is git-ignored; never commit it.
# Keepshot has no accounts or cloud services, so there are no API keys here.
# All values are optional.

# Where captures, exports and the library database live.
# Default: %USERPROFILE%\Videos\Keepshot
KEEPSHOT_DATA_DIR=

# ffmpeg / ffprobe binaries. Default: found on PATH.
KEEPSHOT_FFMPEG=
KEEPSHOT_FFPROBE=

# Local transcription with whisper.cpp. `npm run setup:whisper` fills these in.
KEEPSHOT_WHISPER_BIN=
KEEPSHOT_WHISPER_MODEL=
